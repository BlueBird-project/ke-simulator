# ENTSO-E Transparency Platform API token.
# No VITE_ prefix on purpose: it must stay server-side only (read by
# vite.config.ts's dev proxy) and must never be bundled into client code.
# While unset, MarketDataService falls back to mock day-ahead/intraday prices
# (see src/services/MarketDataService.ts).
ENTSOE_API_TOKEN=

# Non-secret: ENTSO-E bidding zone EIC code. Defaults to Spain (REE) if unset.
VITE_ENTSOE_BIDDING_ZONE=10YES-REE------0
