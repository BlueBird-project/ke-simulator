# KE Bridge configuration — copy to .env and adjust.

# Knowledge Engine Smart Connector REST endpoint (MUST end with /rest/).
# When running on TM's external network, reach the SC by service name.
KE_REST_ENDPOINT=http://tm-ke-service:8280/rest/

# Unique Knowledge Base id for the simulator (decision D-Q1).
KE_KNOWLEDGE_BASE_ID=http://simulator.bluebird.com

# Graph-pattern config.
KE_KI_CONFIG_PATH=./resources/ke_config.yml

# KE behaviour (align with TM's deployment).
KE_VERIFY_SERVER_CERT=false
KE_REASONER_LEVEL=1
KE_ALLOW_PARTIAL_KI=true

# Bridge HTTP server.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8090
